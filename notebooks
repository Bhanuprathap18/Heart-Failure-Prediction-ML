      "source": [
        "# Heart Failure Prediction Using Machine Learning\n",
        "\n",
        "A reproducible implementation of the workflow described in the project presentation.\n",
        "\n",
        "**Target:** `DEATH_EVENT`\n",
        "\n",
        "**Models:** Logistic Regression, Decision Tree, SVM, and Neural Network (MLP).\n",
        "\n",
        "**Evaluation:** accuracy, precision, recall, F1-score, ROC-AUC, confusion matrix, and ROC curves.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import os\n",
        "import urllib.request\n",
        "import warnings\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "from sklearn.model_selection import train_test_split, StratifiedKFold, GridSearchCV\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.impute import SimpleImputer\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.tree import DecisionTreeClassifier\n",
        "from sklearn.svm import SVC\n",
        "from sklearn.neural_network import MLPClassifier\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score, precision_score, recall_score, f1_score,\n",
        "    roc_auc_score, confusion_matrix, classification_report, roc_curve\n",
        ")\n",
        "\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "RANDOM_STATE = 42\n",
        "os.makedirs(\"../results\", exist_ok=True)\n",
        "os.makedirs(\"../data\", exist_ok=True)\n",
        "DATA_URL = \"https://raw.githubusercontent.com/briggyx/heart_failure_dashboard/main/data/heart_failure_clinical_records_original.csv\"\n",
        "DATA_PATH = \"../data/heart_failure_clinical_records.csv\"\n",
        "\n",
        "if not os.path.exists(DATA_PATH):\n",
        "    urllib.request.urlretrieve(DATA_URL, DATA_PATH)\n",
        "\n",
        "df = pd.read_csv(DATA_PATH)\n",
        "print(\"Shape:\", df.shape)\n",
        "df.head()\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 1. Dataset inspection"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "print(df.info())\n",
        "print(\"\\nMissing values:\")\n",
        "print(df.isna().sum())\n",
        "print(\"\\nTarget distribution:\")\n",
        "print(df[\"DEATH_EVENT\"].value_counts())\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "plt.figure(figsize=(7, 4))\n",
        "sns.countplot(data=df, x=\"DEATH_EVENT\")\n",
        "plt.title(\"DEATH_EVENT Distribution\")\n",
        "plt.xlabel(\"DEATH_EVENT (0 = survival, 1 = death)\")\n",
        "plt.ylabel(\"Number of records\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"../results/target_distribution.png\", dpi=200)\n",
        "plt.show()\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 2. Exploratory analysis"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "plt.figure(figsize=(10, 7))\n",
        "sns.heatmap(df.corr(numeric_only=True), cmap=\"coolwarm\", center=0)\n",
        "plt.title(\"Feature Correlation Matrix\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"../results/correlation_matrix.png\", dpi=200)\n",
        "plt.show()\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
        "sns.boxplot(data=df, x=\"DEATH_EVENT\", y=\"ejection_fraction\", ax=axes[0])\n",
        "axes[0].set_title(\"Ejection Fraction vs DEATH_EVENT\")\n",
        "sns.boxplot(data=df, x=\"DEATH_EVENT\", y=\"serum_creatinine\", ax=axes[1])\n",
        "axes[1].set_title(\"Serum Creatinine vs DEATH_EVENT\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"../results/key_feature_boxplots.png\", dpi=200)\n",
        "plt.show()\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 3. Feature engineering and train/test split\n",
        "\n",
        "A simple engineered feature is added to capture the relationship between serum creatinine and ejection fraction. The original variables are retained.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "work = df.copy()\n",
        "\n",
        "work[\"creatinine_ef_ratio\"] = (\n",
        "    work[\"serum_creatinine\"] /\n",
        "    work[\"ejection_fraction\"].replace(0, np.nan)\n",
        ")\n",
        "\n",
        "X = work.drop(columns=[\"DEATH_EVENT\"])\n",
        "y = work[\"DEATH_EVENT\"]\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X, y,\n",
        "    test_size=0.20,\n",
        "    stratify=y,\n",
        "    random_state=RANDOM_STATE\n",
        ")\n",
        "\n",
        "print(\"Training shape:\", X_train.shape)\n",
        "print(\"Testing shape :\", X_test.shape)\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 4. Model definitions and hyperparameter tuning"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=RANDOM_STATE)\n",
        "\n",
        "models = {\n",
        "    \"Logistic Regression\": (\n",
        "        Pipeline([\n",
        "            (\"imputer\", SimpleImputer(strategy=\"median\")),\n",
        "            (\"scaler\", StandardScaler()),\n",
        "            (\"model\", LogisticRegression(max_iter=3000, random_state=RANDOM_STATE))\n",
        "        ]),\n",
        "        {\"model__C\": [0.01, 0.1, 1, 10]}\n",
        "    ),\n",
        "    \"Decision Tree\": (\n",
        "        Pipeline([\n",
        "            (\"imputer\", SimpleImputer(strategy=\"median\")),\n",
        "            (\"model\", DecisionTreeClassifier(random_state=RANDOM_STATE))\n",
        "        ]),\n",
        "        {\n",
        "            \"model__max_depth\": [3, 5, 8, None],\n",
        "            \"model__min_samples_split\": [2, 5, 10]\n",
        "        }\n",
        "    ),\n",
        "    \"SVM\": (\n",
        "        Pipeline([\n",
        "            (\"imputer\", SimpleImputer(strategy=\"median\")),\n",
        "            (\"scaler\", StandardScaler()),\n",
        "            (\"model\", SVC(probability=True, random_state=RANDOM_STATE))\n",
        "        ]),\n",
        "        {\n",
        "            \"model__C\": [0.1, 1, 10],\n",
        "            \"model__kernel\": [\"linear\", \"rbf\"],\n",
        "            \"model__gamma\": [\"scale\", \"auto\"]\n",
        "        }\n",
        "    ),\n",
        "    \"Neural Network\": (\n",
        "        Pipeline([\n",
        "            (\"imputer\", SimpleImputer(strategy=\"median\")),\n",
        "            (\"scaler\", StandardScaler()),\n",
        "            (\"model\", MLPClassifier(\n",
        "                max_iter=1000,\n",
        "                early_stopping=True,\n",
        "                random_state=RANDOM_STATE\n",
        "            ))\n",
        "        ]),\n",
        "        {\n",
        "            \"model__hidden_layer_sizes\": [(32,), (64,), (32, 16)],\n",
        "            \"model__alpha\": [0.0001, 0.001, 0.01]\n",
        "        }\n",
        "    )\n",
        "}\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "best_models = {}\n",
        "cv_rows = []\n",
        "\n",
        "for name, (pipeline, params) in models.items():\n",
        "    search = GridSearchCV(\n",
        "        pipeline,\n",
        "        params,\n",
        "        scoring=\"roc_auc\",\n",
        "        cv=cv,\n",
        "        n_jobs=-1,\n",
        "        refit=True\n",
        "    )\n",
        "    search.fit(X_train, y_train)\n",
        "    best_models[name] = search.best_estimator_\n",
        "\n",
        "    cv_rows.append({\n",
        "        \"Model\": name,\n",
        "        \"Best CV ROC-AUC\": search.best_score_,\n",
        "        \"Best Parameters\": search.best_params_\n",
        "    })\n",
        "\n",
        "cv_results = pd.DataFrame(cv_rows).sort_values(\n",
        "    \"Best CV ROC-AUC\", ascending=False\n",
        ")\n",
        "cv_results\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 5. Test-set evaluation"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "results = []\n",
        "predictions = {}\n",
        "\n",
        "for name, model in best_models.items():\n",
        "    y_pred = model.predict(X_test)\n",
        "    y_prob = model.predict_proba(X_test)[:, 1]\n",
        "\n",
        "    predictions[name] = (y_pred, y_prob)\n",
        "\n",
        "    results.append({\n",
        "        \"Model\": name,\n",
        "        \"Accuracy\": accuracy_score(y_test, y_pred),\n",
        "        \"Precision\": precision_score(y_test, y_pred, zero_division=0),\n",
        "        \"Recall\": recall_score(y_test, y_pred, zero_division=0),\n",
        "        \"F1-Score\": f1_score(y_test, y_pred, zero_division=0),\n",
        "        \"ROC-AUC\": roc_auc_score(y_test, y_prob)\n",
        "    })\n",
        "\n",
        "results_df = pd.DataFrame(results).sort_values(\n",
        "    \"ROC-AUC\", ascending=False\n",
        ")\n",
        "results_df.round(4)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "results_df.to_csv(\"../results/model_comparison.csv\", index=False)\n",
        "\n",
        "ax = results_df.set_index(\"Model\")[\n",
        "    [\"Accuracy\", \"Precision\", \"Recall\", \"F1-Score\", \"ROC-AUC\"]\n",
        "].plot(kind=\"bar\", figsize=(11, 5))\n",
        "\n",
        "ax.set_title(\"Model Performance Comparison\")\n",
        "ax.set_ylabel(\"Score\")\n",
        "ax.set_ylim(0, 1)\n",
        "plt.xticks(rotation=20)\n",
        "plt.legend(loc=\"lower right\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"../results/model_comparison.png\", dpi=200)\n",
        "plt.show()\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 6. ROC-AUC analysis"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "plt.figure(figsize=(8, 6))\n",
        "\n",
        "for name, (_, y_prob) in predictions.items():\n",
        "    fpr, tpr, _ = roc_curve(y_test, y_prob)\n",
        "    auc = roc_auc_score(y_test, y_prob)\n",
        "    plt.plot(fpr, tpr, label=f\"{name} (AUC={auc:.3f})\")\n",
        "\n",
        "plt.plot([0, 1], [0, 1], linestyle=\"--\")\n",
        "plt.xlabel(\"False Positive Rate\")\n",
        "plt.ylabel(\"True Positive Rate\")\n",
        "plt.title(\"ROC Curves\")\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"../results/roc_curves.png\", dpi=200)\n",
        "plt.show()\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 7. Error analysis"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "best_name = results_df.iloc[0][\"Model\"]\n",
        "best_model = best_models[best_name]\n",
        "best_pred, best_prob = predictions[best_name]\n",
        "\n",
        "cm = confusion_matrix(y_test, best_pred)\n",
        "\n",
        "print(\"Best model:\", best_name)\n",
        "print(\"\\nClassification report:\")\n",
        "print(classification_report(\n",
        "    y_test, best_pred, digits=4, zero_division=0\n",
        "))\n",
        "\n",
        "plt.figure(figsize=(5, 4))\n",
        "sns.heatmap(cm, annot=True, fmt=\"d\", cmap=\"Blues\")\n",
        "plt.title(f\"Confusion Matrix - {best_name}\")\n",
        "plt.xlabel(\"Predicted\")\n",
        "plt.ylabel(\"Actual\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"../results/confusion_matrix.png\", dpi=200)\n",
        "plt.show()\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 8. Interpretation\n",
        "\n",
