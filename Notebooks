      "source": [
        "## 3. Feature engineering and train/test split\n",
        "\n",
        "A simple engineered feature is added to capture the relationship between serum creatinine and ejection fraction. The original variables are retained.\n"
      ],
      "id": "mF8gu_El1eHr"
    },
    {
      "cell_type": "code",
      "execution_count": 7,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "HI27iEmB1eHs",
        "outputId": "4261e8e9-245c-4bae-be29-898a5c87c6cf"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Training shape: (4000, 13)\n",
            "Testing shape : (1000, 13)\n"
          ]
        }
      ],
      "source": [
        "work = df.copy()\n",
        "\n",
        "work[\"creatinine_ef_ratio\"] = (\n",
        "    work[\"serum_creatinine\"] /\n",
        "    work[\"ejection_fraction\"].replace(0, np.nan)\n",
        ")\n",
        "\n",
        "X = work.drop(columns=[\"DEATH_EVENT\"])\n",
        "y = work[\"DEATH_EVENT\"]\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X, y,\n",
        "    test_size=0.20,\n",
        "    stratify=y,\n",
        "    random_state=RANDOM_STATE\n",
        ")\n",
        "\n",
        "print(\"Training shape:\", X_train.shape)\n",
        "print(\"Testing shape :\", X_test.shape)\n"
      ],
      "id": "HI27iEmB1eHs"
    },
